{
    "name": "petclinix/php-twig-mtier",
    "description": "PetcliniX — classic server-rendered PHP MVC showcase (Twig, hand-rolled data layer, no ORM).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "twig/twig": "^3.9",
        "nikic/fast-route": "^1.3"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "phpstan": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=1G",
        "cs-check": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff",
        "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "deptrac": "deptrac analyse --no-cache",
        "lint": [
            "@cs-check",
            "@phpstan",
            "@deptrac"
        ]
    }
}
