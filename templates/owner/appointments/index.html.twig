{% extends 'base.html.twig' %}

{% block title %}Appointments — PetcliniX{% endblock %}

{% block content %}
    <h2>My Appointments</h2>

    {% if appointments is empty %}
        <p>No appointments yet.</p>
    {% else %}
        <ul>
            {% for appointment in appointments %}
                <li>
                    {{ appointment.scheduledAt|date('Y-m-d H:i') }} —
                    {{ petsById[appointment.petId].name }} with
                    Dr. {{ vetsById[appointment.vetId].lastName }}
                    ({{ appointment.status.value }})
                    {%- if appointment.reason %} — {{ appointment.reason }}{% endif %}

                    {% if appointment.status.value in ['requested', 'confirmed'] %}
                        <a href="/owner/appointments/{{ appointment.id }}/reschedule">Reschedule</a>
                        <form method="post" action="/owner/appointments/{{ appointment.id }}/cancel" style="display:inline">
                            <button type="submit">Cancel</button>
                        </form>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    <h3>Book an Appointment</h3>

    {% if pets is empty %}
        <p>Add a pet before booking an appointment.</p>
    {% else %}
        {% if errors is not empty %}
            <ul>
                {% for error in errors %}
                    <li>{{ error }}</li>
                {% endfor %}
            </ul>
        {% endif %}

        <form method="get" action="/owner/appointments">
            <label>
                Vet
                <select name="vet_id" required>
                    <option value="">Select a vet</option>
                    {% for vet in vets %}
                        <option value="{{ vet.id }}" {% if selectedVetId == vet.id %}selected{% endif %}>Dr. {{ vet.firstName }} {{ vet.lastName }} ({{ vet.specialty }})</option>
                    {% endfor %}
                </select>
            </label>
            <label>
                Duration
                <select name="duration_minutes">
                    {% for minutes in allowedDurations %}
                        <option value="{{ minutes }}" {% if selectedDuration == minutes %}selected{% endif %}>{{ minutes }} minutes</option>
                    {% endfor %}
                </select>
            </label>
            <button type="submit">Show available times</button>
        </form>

        {% if selectedVetId %}
            {% if slotOptions is empty %}
                <p>Dr. {{ vetsById[selectedVetId].lastName }} has no open times right now. Try another vet.</p>
            {% else %}
                <form method="post" action="/owner/appointments">
                    <input type="hidden" name="vet_id" value="{{ selectedVetId }}">
                    <input type="hidden" name="duration_minutes" value="{{ selectedDuration }}">

                    <label>
                        Pet
                        <select name="pet_id" required>
                            <option value="">Select a pet</option>
                            {% for pet in pets %}
                                <option value="{{ pet.id }}" {% if old.pet_id|default('') == pet.id %}selected{% endif %}>{{ pet.name }}</option>
                            {% endfor %}
                        </select>
                    </label>

                    <label>
                        Date and time
                        <select name="scheduled_at" required>
                            <option value="">Select a time</option>
                            {% for slot in slotOptions %}
                                <option value="{{ slot.value }}" {% if old.scheduled_at|default('') == slot.value %}selected{% endif %}>{{ slot.label }}</option>
                            {% endfor %}
                        </select>
                    </label>

                    <label>
                        Reason
                        <input type="text" name="reason" value="{{ old.reason|default('') }}">
                    </label>

                    <button type="submit">Book Appointment</button>
                </form>
            {% endif %}
        {% endif %}
    {% endif %}
{% endblock %}
