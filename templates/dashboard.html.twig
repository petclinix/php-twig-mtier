{% extends 'base.html.twig' %}

{% block title %}Dashboard — PetcliniX{% endblock %}

{% block content %}
    {% if user %}
        <p>Logged in as {{ user.email }} ({{ user.role.value }}).</p>
    {% else %}
        <p>Session user not found.</p>
    {% endif %}

    {% if current_user_role == 'owner' %}
        <nav>
            <a href="/owner/pets">My Pets</a>
            <a href="/owner/appointments">Appointments</a>
            <a href="/owner/visits">Visit History</a>
        </nav>
    {% elseif current_user_role == 'vet' %}
        <nav>
            <a href="/vet/availability">Availability</a>
            <a href="/vet/appointments">Appointments</a>
        </nav>
    {% endif %}
{% endblock %}
