# Copy this file to .env and fill in real values. .env is gitignored.

# Required. Generate via: SonarQube UI -> My Account -> Security ->
# Generate Token (after first login; default admin/admin, forced
# password change on first login — this step can't be automated).
SONAR_TOKEN=

# Optional. Where sonar-analyze.sh polls for SonarQube readiness from the
# HOST. Only relevant when SONAR_STARTUP=1.
# SONAR_HOST_URL=http://host.containers.internal:9000

# Optional. Set to "1" to have sonar-analyze.sh start/manage SonarQube
# itself via docker-compose.analyze.yml. Leave unset if you run
# SonarQube separately.
# SONAR_STARTUP=1
